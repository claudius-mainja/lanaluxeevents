# Public, non-secret configuration.
# Copy this file to .env.local and fill in the real values.

# Canonical public site URL (used for metadata, sitemap and structured data).
NEXT_PUBLIC_SITE_URL=https://www.lanaluxeevents.co.za

# Enquiry destinations (safe: these are already published contact details).
NEXT_PUBLIC_WHATSAPP_NUMBER=27645440804
NEXT_PUBLIC_PHONE_NUMBER=+27761265694
NEXT_PUBLIC_EMAIL=hello@lanaluxeevents.co.za

# Analytics identifiers. Leave blank to disable the corresponding tags.
# GA4 measurement ID (client-owned account). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID (client-owned account). Example: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Set to "true" to noindex the whole deployment (preview/staging protection).
NEXT_PUBLIC_NOINDEX=false
